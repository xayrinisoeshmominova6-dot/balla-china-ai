# ============================================
# BALLA CHINA AI MANAGER — sozlamalar namunasi
# ============================================
# QANDAY ISHLATILADI:
# 1. Bu faylni nusxalab, nomini ".env" qiling:   cp .env.example .env
# 2. ".env" faylidagi bo'sh joylarga o'z kalitlaringizni yozing.
# 3. ".env" faylini HECH KIMGA yubormang va GitHub'ga yuklamang
#    (.gitignore uni avtomatik himoya qiladi).
# ============================================

# --- Claude API (1-bosqichda kerak bo'ladi) ---
# Olish joyi: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Telegram bot (2-bosqichda kerak bo'ladi) ---
# Token: Telegram'da @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Sizning shaxsiy chat ID'ingiz. Bot FAQAT shu ID'dan buyruq qabul qiladi.
# Bilish uchun: Telegram'da @userinfobot ga yozing.
TELEGRAM_ADMIN_CHAT_ID=

# --- Instagram Graph API (3-bosqich) ---
# README'dagi "Instagram'ni ulash" bo'limiga qarang.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=v21.0

# --- Rasmlarni vaqtincha joylash (Instagram faqat internet havolasidan oladi) ---
# Bepul kalit: https://api.imgbb.com -> "Get API key". Rasmlar 24 soatdan keyin o'chadi.
IMGBB_API_KEY=

# --- Xavfsizlik ---
# true  = Instagram'ga HECH NARSA yuborilmaydi (sinov rejimi)
# false = tasdiqlangan kontent haqiqatan joylanadi
# Ishonchingiz komil bo'lmaguncha "true" qoldiring.
DRY_RUN=true
