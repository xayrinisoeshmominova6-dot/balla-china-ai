# ============================================================
# BALLA CHINA AI — sozlamalar namunasi
# ============================================================
# QANDAY ISHLATILADI:
#   1. Bu faylni nusxalang:   cp .env.example .env
#   2. .env faylini oching va haqiqiy qiymatlarni yozing.
#   3. .env fayli GitHub'ga YUKLANMAYDI (.gitignore himoya qiladi).
#
# DIQQAT: Bu (.env.example) faylga hech qachon haqiqiy kalit yozmang!
# ============================================================

# --- Claude API (majburiy) ---
# Kalitni bu yerdan olasiz: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Qaysi Claude modeli ishlatiladi (o'zgartirish shart emas)
BALLA_CLAUDE_MODEL=claude-opus-5-5

# Fikrlash chuqurligi: low | medium | high | xhigh | max
BALLA_CLAUDE_EFFORT=high

# --- Instagram Graph API (ixtiyoriy, 7-bosqichda kerak bo'ladi) ---
# Bo'sh qolsa, Publisher faqat "quruq rejim"da ishlaydi (hech narsa joylamaydi).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Ma'lumotlar bazasi ---
BALLA_DATABASE_PATH=output/balla.db
